{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portal Static Module Release",
  "type": "object",
  "required": ["module_id", "entrypoint", "files", "hash_algorithm"],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.html$"
    },
    "hash_algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "byte_count"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
